<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_outpass" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="hostel-outpass" name="Hostel Out-Pass Request" isExecutable="true">
    <bpmn:startEvent id="Start_requested" name="Out-pass requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_requested" targetRef="Task_check" />
    <bpmn:serviceTask id="Task_check" name="Check request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-outpass" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_check" targetRef="Gateway_route" />
    <bpmn:exclusiveGateway id="Gateway_route" name="Valid? Nights?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_warden</bpmn:outgoing>
      <bpmn:outgoing>Flow_invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_auto" name="day out (nights = 0)" sourceRef="Gateway_route" targetRef="Gateway_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid and nights = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_warden" name="nights &gt;= 1" sourceRef="Gateway_route" targetRef="UserTask_warden">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid and nights &gt;= 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_invalid" name="invalid dates" sourceRef="Gateway_route" targetRef="Gateway_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(valid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="UserTask_warden" name="Warden approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="warden-approval-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_warden</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="UserTask_warden" targetRef="Gateway_merge" />
    <bpmn:exclusiveGateway id="Gateway_merge">
      <bpmn:incoming>Flow_auto</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_merge" targetRef="Task_issue" />
    <bpmn:serviceTask id="Task_issue" name="Issue out-pass">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issue-outpass" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_issue" targetRef="End_done" />
    <bpmn:endEvent id="End_done" name="Pass issued / rejected">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hostel-outpass">
      <bpmndi:BPMNShape id="S_start" bpmnElement="Start_requested"><dc:Bounds x="152" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="130" y="225" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_check" bpmnElement="Task_check"><dc:Bounds x="250" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_gw" bpmnElement="Gateway_route" isMarkerVisible="true"><dc:Bounds x="415" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="405" y="232" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_user" bpmnElement="UserTask_warden"><dc:Bounds x="540" y="40" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_merge" bpmnElement="Gateway_merge" isMarkerVisible="true"><dc:Bounds x="715" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_issue" bpmnElement="Task_issue"><dc:Bounds x="830" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_end" bpmnElement="End_done"><dc:Bounds x="992" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="970" y="225" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="Flow_1"><di:waypoint x="188" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="Flow_2"><di:waypoint x="350" y="200" /><di:waypoint x="415" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Eauto" bpmnElement="Flow_auto"><di:waypoint x="465" y="200" /><di:waypoint x="715" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="550" y="182" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ewarden" bpmnElement="Flow_warden"><di:waypoint x="440" y="175" /><di:waypoint x="440" y="80" /><di:waypoint x="540" y="80" /><bpmndi:BPMNLabel><dc:Bounds x="450" y="60" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Einvalid" bpmnElement="Flow_invalid"><di:waypoint x="440" y="225" /><di:waypoint x="440" y="310" /><di:waypoint x="740" y="310" /><di:waypoint x="740" y="225" /><bpmndi:BPMNLabel><dc:Bounds x="560" y="292" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="Flow_5"><di:waypoint x="640" y="80" /><di:waypoint x="740" y="80" /><di:waypoint x="740" y="175" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="Flow_6"><di:waypoint x="765" y="200" /><di:waypoint x="830" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="Flow_7"><di:waypoint x="930" y="200" /><di:waypoint x="992" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
